# ==========================================
# VisionQC Environment Configuration Template
# ==========================================

# Application Environment
APP_ENV=development
LOG_LEVEL=INFO

# Backend API
API_V1_STR=/api/v1
PROJECT_NAME="VisionQC"
HOST=0.0.0.0
PORT=8000

# Database Configuration (PostgreSQL 18)
POSTGRES_USER=visionqc_user
POSTGRES_PASSWORD=visionqc_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://visionqc_user:visionqc_password@postgres:5432/visionqc_app

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://mlflow:5000
MLFLOW_BACKEND_STORE_URI=postgresql://visionqc_user:visionqc_password@postgres:5432/visionqc_mlflow
MLFLOW_ARTIFACT_ROOT=/mlartifacts

# Apache Airflow Configuration
AIRFLOW_BASE_URL=http://airflow-webserver:8080
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg://visionqc_user:visionqc_password@postgres:5432/visionqc_airflow

# Monitoring & Metrics
PROMETHEUS_URL=http://prometheus:9090
GRAFANA_PORT=3001

# Frontend Configuration
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Optional AWS Settings
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
